#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

// Define a byte as an 8-bit unsigned integer
typedef uint8_t BYTE;

// JPEG files are stored in blocks of 512 bytes
const int BLOCK_SIZE = 512;

int main(int argc, char *argv[])
{
    // Check for correct usage: should have exactly one command-line argument
    if (argc != 2)
    {
        printf("Usage: ./recover IMAGE\n");
        return 1;
    }

    // Open the forensic image (memory card) for reading
    FILE *raw_file = fopen(argv[1], "r");
    if (raw_file == NULL)
    {
        printf("Could not open file %s\n", argv[1]);
        return 1;
    }

    // Buffer to store a block of data
    BYTE buffer[BLOCK_SIZE];

    // Variables to track files and naming
    FILE *img_ptr = NULL;
    char filename[8]; // Format: ###.jpg\0
    int file_count = 0;

    // Read 512-byte blocks until the end of the memory card
    while (fread(buffer, 1, BLOCK_SIZE, raw_file) == BLOCK_SIZE)
    {
        // Check if the block marks the start of a new JPEG
        // JPEGs start with 0xff 0xd8 0xff followed by 0xe0 through 0xef
        if (buffer[0] == 0xff && buffer[1] == 0xd8 && buffer[2] == 0xff && (buffer[3] & 0xf0) == 0xe0)
        {
            // If we are already writing to a JPEG, close the current one
            if (img_ptr != NULL)
            {
                fclose(img_ptr);
            }

            // Create a new filename (e.g., 000.jpg, 001.jpg)
            sprintf(filename, "%03i.jpg", file_count);
            
            // Open a new file pointer for writing the image
            img_ptr = fopen(filename, "w");
            file_count++;
        }

        // If a JPEG is currently open, write the block to it
        if (img_ptr != NULL)
        {
            fwrite(buffer, 1, BLOCK_SIZE, img_ptr);
        }
    }

    // Close any remaining open files
    if (img_ptr != NULL)
    {
        fclose(img_ptr);
    }

    fclose(raw_file);

    return 0;
}
