// word_list.c
// CS50x — Vocabulary Management Exercise
// 
// Practice with strings, arrays, and basic search algorithms.

#include <stdio.h>
#include <string.h>
#include <stdbool.h>

// Define the number of words in the list
#define WORD_COUNT 200 // Adjusted for the provided sample

// A small sample of the provided list for demonstration
const char *dictionary[] = {
    "abandon", "ability", "able", "about", "above", "abroad", "absent",
    "absolute", "accept", "accident", "account", "ache", "achieve", "across",
    "act", "add", "admire", "admit", "adopt", "advance", "after", "again",
    "age", "agree", "ahead", "aid", "aim", "air", "all", "allow"
    // ... the rest of the words would go here
};

bool find_word(char *word);

int main(int argc, char *argv[])
{
    // Ensure the user provides a word to search for
    if (argc != 2)
    {
        printf("Usage: ./word_list WORD\n");
        return 1;
    }

    // Search for the word in our dictionary
    if (find_word(argv[1]))
    {
        printf("Found: %s is in the list!\n", argv[1]);
    }
    else
    {
        printf("Not found: %s is not in the list.\n", argv[1]);
    }

    return 0;
}

/**
 * Linear search implementation to find a word in the array.
 */
bool find_word(char *word)
{
    for (int i = 0; i < 30; i++) // Checking only the demonstration sample size
    {
        // strcmp returns 0 if the strings are identical
        if (strcmp(dictionary[i], word) == 0)
        {
            return true;
        }
    }
    return false;
}
