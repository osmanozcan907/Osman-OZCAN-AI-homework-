# Get input from user and convert to float
celsius = float(input("Enter temperature in Celsius: "))

# TODO: calculate fahrenheit using the formula F = (C × 9/5) + 32
fahrenheit = (celsius * 9/5) + 32

# TODO: print the result using an f-string
print(f"{celsius}°C is equal to {fahrenheit}°F")

# ── Bonus (optional) ─────────────────────────────────────────────────────────
# Add a direction menu (C→F or F→C)

print("\n--- Advanced Converter ---")
choice = input("Type '1' for C to F, or '2' for F to C: ")

if choice == '1':
    c = float(input("Celsius: "))
    f = (c * 9/5) + 32
    print(f"Result: {f}°F")
elif choice == '2':
    f = float(input("Fahrenheit: "))
    c = (f - 32) * 5/9
    print(f"Result: {c}°C")
else:
    print("Invalid selection.")
