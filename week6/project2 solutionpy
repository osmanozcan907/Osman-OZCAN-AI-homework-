import random

# TODO: generate a random secret number between 1 and 10
secret_number = random.randint(1, 10)

# TODO: set up a guesses counter
guesses_count = 0

print("I'm thinking of a number between 1 and 10.")

# TODO: while loop — keep asking until the guess is correct
while True:
    # TODO: get the user's guess
    guess = int(input("Take a guess: "))
    guesses_count += 1
    
    # Check the guess
    if guess < secret_number:
        print("Too low!")
    elif guess > secret_number:
        print("Too high!")
    else:
        # This means the guess is correct!
        break

# TODO: print the congratulations message with the number of guesses
print(f"Congratulations! You guessed the number in {guesses_count} tries.")
