<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Fetch & APIs - Master File</title>
  <style>
    /* --- CSS Styles --- */
    :root {
      --primary: #6366f1;
      --bg: #0f172a;
      --card-bg: #1e293b;
      --text: #f8fafc;
      --accent: #22d3ee;
    }

    body {
      font-family: 'Segoe UI', system-ui, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.6;
      margin: 0;
      padding: 20px;
    }

    header { text-align: center; margin-bottom: 3rem; }
    main { max-width: 800px; margin: 0 auto; }

    .card {
      background: var(--card-bg);
      padding: 25px;
      border-radius: 16px;
      margin-bottom: 25px;
      border: 1px solid #334155;
    }

    h2 { color: var(--accent); margin-top: 0; font-size: 1.4rem; }

    /* Task 1 & 2 UI */
    #quote-display, #github-result, #multi-result {
      background: rgba(0,0,0,0.2);
      padding: 15px;
      border-radius: 8px;
      margin: 15px 0;
      min-height: 50px;
    }

    .search-row { display: flex; gap: 10px; }
    input {
      flex: 1;
      padding: 10px;
      border-radius: 6px;
      border: 1px solid #475569;
      background: #334155;
      color: white;
    }

    button {
      background: var(--primary);
      color: white;
      border: none;
      padding: 10px 20px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
      transition: transform 0.1s;
    }

    button:active { transform: scale(0.95); }

    /* Task 3: Posts */
    .post-item {
      border-left: 4px solid var(--primary);
      padding-left: 15px;
      margin-bottom: 15px;
      background: rgba(255,255,255,0.05);
      padding: 10px;
    }

    /* GitHub Profile UI */
    .gh-profile { display: flex; align-items: center; gap: 20px; }
    .gh-profile img { width: 80px; border-radius: 50%; border: 2px solid var(--accent); }

    .error { color: #f87171; font-weight: bold; }
    .loading { opacity: 0.5; font-style: italic; }
  </style>
</head>
<body>

  <header>
    <h1>Fetch & REST APIs 🌍</h1>
    <p>Asynchronous data handling for modern web apps.</p>
  </header>

  <main>
    <!-- TASK 1: Quote -->
    <section class="card" id="quote-section">
      <h2>🗣️ Task 1 — Random Quote</h2>
      <div id="quote-display">
        <p class="placeholder">Click the button to fetch a random quote.</p>
      </div>
      <button id="btn-new-quote">✨ New Quote</button>
    </section>

    <!-- TASK 2: GitHub Search -->
    <section class="card" id="github-section">
      <h2>🐙 Task 2 — GitHub User Search</h2>
      <div class="search-row">
        <input type="text" id="github-input" placeholder="Enter a GitHub username..." />
        <button id="btn-search-user">Search</button>
      </div>
      <div id="github-result"></div>
    </section>

    <!-- TASK 3: Posts Feed -->
    <section class="card" id="posts-section">
      <h2>📰 Task 3 — Posts Feed</h2>
      <div id="posts-container"></div>
      <button id="btn-load-more">Load More Posts</button>
    </section>

    <!-- TASK 5: Promise.all -->
    <section class="card" id="multi-fetch-section">
      <h2>⚡ Task 5 — Parallel Fetch (Promise.all)</h2>
      <button id="btn-fetch-all">Fetch All Three at Once</button>
      <div id="multi-result"></div>
    </section>
  </main>

  <script>
    /* --- JAVASCRIPT LOGIC --- */

    // 1. Random Quote (Using dummyjson or quotable)
    const quoteBtn = document.getElementById('btn-new-quote');
    const quoteDisplay = document.getElementById('quote-display');

    async function fetchQuote() {
      quoteDisplay.innerHTML = '<p class="loading">Fetching inspiration...</p>';
      try {
        const response = await fetch('https://dummyjson.com/quotes/random');
        const data = await response.json();
        quoteDisplay.innerHTML = `
          <p style="font-size: 1.2rem; font-style: italic;">"${data.quote}"</p>
          <p style="text-align: right; color: var(--accent);">— ${data.author}</p>
        `;
      } catch (err) {
        quoteDisplay.innerHTML = '<p class="error">Failed to fetch quote.</p>';
      }
    }
    quoteBtn.addEventListener('click', fetchQuote);


    // 2. GitHub User Search
    const ghInput = document.getElementById('github-input');
    const ghBtn = document.getElementById('btn-search-user');
    const ghResult = document.getElementById('github-result');

    async function searchGitHub() {
      const username = ghInput.value.trim();
      if (!username) return;

      ghResult.innerHTML = '<p class="loading">Searching GitHub...</p>';
      try {
        const res = await fetch(`https://api.github.com/users/${username}`);
        if (!res.ok) throw new Error('User not found');
        const user = await res.json();
        
        ghResult.innerHTML = `
          <div class="gh-profile">
            <img src="${user.avatar_url}" alt="avatar">
            <div>
              <h3>${user.name || user.login}</h3>
              <p>${user.bio || 'No bio available'}</p>
              <small>Public Repos: ${user.public_repos}</small>
            </div>
          </div>
        `;
      } catch (err) {
        ghResult.innerHTML = `<p class="error">${err.message}</p>`;
      }
    }
    ghBtn.addEventListener('click', searchGitHub);


    // 3. Posts Feed (Pagination simulation)
    const postsContainer = document.getElementById('posts-container');
    const loadMoreBtn = document.getElementById('btn-load-more');
    let postSkip = 0;

    async function loadPosts() {
      try {
        const res = await fetch(`https://jsonplaceholder.typicode.com/posts?_start=${postSkip}&_limit=3`);
        const posts = await res.json();
        
        posts.forEach(post => {
          const div = document.createElement('div');
          div.className = 'post-item';
          div.innerHTML = `<strong>${post.title}</strong><p>${post.body.substring(0, 70)}...</p>`;
          postsContainer.appendChild(div);
        });
        postSkip += 3;
      } catch (err) {
        console.error("Posts error:", err);
      }
    }
    loadMoreBtn.addEventListener('click', loadPosts);
    loadPosts(); // Initial load


    // 5. Parallel Fetch (Promise.all)
    const multiBtn = document.getElementById('btn-fetch-all');
    const multiResult = document.getElementById('multi-result');

    async function fetchAllData() {
      multiResult.innerHTML = '<p class="loading">Fetching 3 sources simultaneously...</p>';
      
      const urls = [
        'https://jsonplaceholder.typicode.com/users/1',
        'https://jsonplaceholder.typicode.com/users/2',
        'https://jsonplaceholder.typicode.com/users/3'
      ];

      try {
        const startTime = performance.now();
        const responses = await Promise.all(urls.map(url => fetch(url).then(r => r.json())));
        const endTime = performance.now();

        multiResult.innerHTML = `
          <p>Fetched <strong>${responses.length}</strong> users in <strong>${Math.round(endTime - startTime)}ms</strong>.</p>
          <ul>${responses.map(u => `<li>${u.name} (${u.email})</li>`).join('')}</ul>
        `;
      } catch (err) {
        multiResult.innerHTML = '<p class="error">One or more requests failed.</p>';
      }
    }
    multiBtn.addEventListener('click', fetchAllData);

  </script>
</body>
</html>
